{
  "name": "@openfleet-tools/create",
  "version": "0.8.0",
  "description": "Scaffold an OpenFleet workspace: npm create @openfleet-tools",
  "license": "MIT",
  "homepage": "https://openfleet.tools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yashicon21/openfleet-tools.git",
    "directory": "packages/create"
  },
  "bugs": {
    "url": "https://github.com/yashicon21/openfleet-tools/issues"
  },
  "type": "module",
  "bin": {
    "create-openfleet": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "access": "public"
  }
}
